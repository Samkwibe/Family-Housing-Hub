# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  FAMILY HOUSING HUB — WEB APP (Vite · Browser · Firebase Hosting)        ║
# ║  File: .env.local (project root)                                        ║
# ║  Restart after changes: npm run dev                                       ║
# ╚══════════════════════════════════════════════════════════════════════════╝
#
#  This file is ONLY for the web app. All vars must start with VITE_
#  ┌─────────────┬──────────────────────────────────────────────────────────┐
#  │ Web app     │  .env.local  ← YOU ARE HERE                              │
#  │ Backend API │  backend/.env                                            │
#  │ Mobile app  │  mobile/.env                                             │
#  └─────────────┴──────────────────────────────────────────────────────────┘


# ─── A) BACKEND API ──────────────────────────────────────────────────────────
VITE_API_URL=http://127.0.0.1:8000
# Production: VITE_API_URL=https://family-housing-hub-api.onrender.com


# ─── B) GOOGLE MAPS — WEB/BROWSER API KEY ────────────────────────────────────
# Can be the same key as mobile/backend OR a separate "Browser key"
# Restrict to: HTTP referrers (your domain) + Maps JavaScript API
# Same project key works if referrers + APIs are allowed in Console
VITE_GOOGLE_MAPS_API_KEY=AIzaSyAl0qSJcMSup0CIU62YQxM-0aNeUEtRVeI


# ─── C) GOOGLE GEMINI — WEB AI ───────────────────────────────────────────────
# Can match backend GEMINI_API_KEY or use a web-restricted key
VITE_GEMINI_API_KEY=AIzaSyDke_AD6NQiKOZVPBzfw4I3JKsWR68oXrE


# ─── D) FIREBASE — WEB APP ONLY ──────────────────────────────────────────────
# Firebase Console → Project settings → Your apps → Web app
VITE_FIREBASE_API_KEY=AIzaSyB9rONAKw6unIEsS2f0qptmSIyflM3q-OM
VITE_FIREBASE_AUTH_DOMAIN=family-housing-hub.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=family-housing-hub
VITE_FIREBASE_STORAGE_BUCKET=family-housing-hub.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=677200955206
VITE_FIREBASE_APP_ID=1:677200955206:web:1008d5edde6b1f02be4747


# ─── WEB DOES NOT USE ────────────────────────────────────────────────────────
# OAuth Client IDs → mobile/.env (Expo Sign-In)
# OPENAI / NVIDIA → backend/.env only
