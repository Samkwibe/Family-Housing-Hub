# BACKEND SERVER ONLY — copy to backend/.env

NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_API_MODEL=meta/llama-3.1-70b-instruct
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
LOCATION_COUNTRY_CODE=us

GOOGLE_OAUTH_CLIENT_IDS=web-client-id.apps.googleusercontent.com,ios-client-id.apps.googleusercontent.com,android-client-id.apps.googleusercontent.com

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=family_housing_hub
JWT_SECRET=change-me-in-production
JWT_EXPIRES_HOURS=168

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_key
EMAIL_FROM=noreply@yourdomain.com

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

CORS_ORIGINS=http://localhost:5173,http://localhost:8081
INVITE_LINK_BASE=familyhousinghub://invite
RESET_LINK_BASE=familyhousinghub://reset-password

# S3 or Cloudflare R2 (S3-compatible)
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=auto

FLASK_ENV=development
PORT=8000

# Upstash Redis (optional locally — graceful no-cache fallback)
REDIS_URL=

# AES-256 field encryption (required — generate: python -c "import secrets; print(secrets.token_hex(32))")
FIELD_ENCRYPTION_KEY=
