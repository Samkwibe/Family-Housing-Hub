[debug] [2025-11-27T19:38:59.845Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/family-housing-hub/rulesets {"name":"projects/family-housing-hub/rulesets/8f660024-8273-492e-8e5e-8b2fd73c88d9","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    \n    // Helper functions\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n    \n    function isOwner(userId) {\n      return isAuthenticated() && request.auth.uid == userId;\n    }\n    \n    // Check if user owns the document (for existing documents)\n    function isDocOwner() {\n      return isAuthenticated() && resource.data.userId == request.auth.uid;\n    }\n    \n    // Check if user is creating their own document\n    function isCreatingOwn() {\n      return isAuthenticated() && request.resource.data.userId == request.auth.uid;\n    }\n    \n    // Users collection - users can read other users' profiles (for messaging/search), but only edit their own\n    match /users/{userId} {\n      allow read: if isAuthenticated(); // Allow reading any user profile for search/messaging\n      allow write: if isOwner(userId); // Only edit own profile\n      // Parents can read their children's profiles\n      allow read: if isAuthenticated() && \n        resource.data.parentId == request.auth.uid;\n    }\n    \n    // Generic rule for user-owned collections\n    // This pattern allows queries filtered by userId\n    match /maintenanceRequests/{docId} {\n      allow read: if isAuthenticated();\n      allow create: if isCreatingOwn();\n      allow update, delete: if isDocOwner();\n    }\n    \n    match /rentPayments/{docId} {\n      allow read: if isAuthenticated();\n      allow create: if isCreatingOwn();\n      allow update, delete: if isDocOwner();\n    }\n    \n    match /documents/{docId} {\n      allow read: if isAuthenticated();\n      allow create: if isCreatingOwn();\n      allow update, delete: if isDocOwner();\n    }\n    \n    // Messages - users can read messages where they are sender OR receiver\n    match /messages/{docId} {\n      // Allow read if user is sender or receiver (works for both get and list queries)\n      // For queries, Firestore will filter results based on this rule\n      allow read: if isAuthenticated() && \n        (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);\n      // Allow create if user is the sender\n      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;\n      // Allow update if user is sender or receiver (for read receipts)\n      allow update: if isAuthenticated() && \n        (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);\n      // Allow delete only if user is sender\n      allow delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;\n    }\n    \n    match /activities/{docId} {\n      allow read: if isAuthenticated();\n      allow create: if isAuthenticated();\n    }\n    \n    match /children/{docId} {\n      allow read: if isAuthenticated();\n      allow create: if isCreatingOwn();\n      allow update, delete: if isDocOwner();\n    }\n    \n    match /savingsGoals/{docId} {\n      allow read: if isAuthenticated();\n      allow create: if isCreatingOwn();\n      allow update, delete: if isDocOwner();\n    }\n    \n    match /healthRecords/{docId} {\n      allow read: if isAuthenticated();\n      allow create: if isCreatingOwn();\n      allow update, delete: if isDocOwner();\n    }\n    \n    match /appointments/{docId} {\n      allow read: if isAuthenticated();\n      allow create: if isCreatingOwn();\n      allow update, delete: if isDocOwner();\n    }\n    \n    match /transactions/{docId} {\n      allow read: if isAuthenticated();\n      allow create: if isCreatingOwn();\n      allow update, delete: if isDocOwner();\n    }\n    \n        match /budgets/{docId} {\n          allow read: if isAuthenticated();\n          allow create: if isCreatingOwn();\n          allow update, delete: if isDocOwner();\n        }\n        \n        match /financialGoals/{docId} {\n          allow read: if isAuthenticated();\n          allow create: if isCreatingOwn();\n          allow update, delete: if isDocOwner();\n        }\n        \n        match /bills/{docId} {\n          allow read: if isAuthenticated();\n          allow create: if isCreatingOwn();\n          allow update, delete: if isDocOwner();\n        }\n        \n        match /accounts/{docId} {\n          allow read: if isAuthenticated();\n          allow create: if isCreatingOwn();\n          allow update, delete: if isDocOwner();\n        }\n        \n        match /recurringTransactions/{docId} {\n          allow read: if isAuthenticated();\n          allow create: if isCreatingOwn();\n          allow update, delete: if isDocOwner();\n        }\n    \n    match /events/{docId} {\n      allow read: if isAuthenticated();\n      allow create: if isCreatingOwn();\n      allow update, delete: if isDocOwner();\n    }\n    \n    match /tasks/{docId} {\n      allow read: if isAuthenticated();\n      allow create: if isCreatingOwn();\n      allow update, delete: if isDocOwner();\n    }\n    \n    match /shoppingItems/{docId} {\n      allow read: if isAuthenticated();\n      allow create: if isCreatingOwn();\n      allow update, delete: if isDocOwner();\n    }\n    \n    match /meals/{docId} {\n      allow read: if isAuthenticated();\n      allow create: if isCreatingOwn();\n      allow update, delete: if isDocOwner();\n    }\n    \n    match /emergencyContacts/{docId} {\n      allow read: if isAuthenticated();\n      allow create: if isCreatingOwn();\n      allow update, delete: if isDocOwner();\n    }\n    \n    match /safeLocations/{docId} {\n      allow read: if isAuthenticated();\n      allow create: if isCreatingOwn();\n      allow update, delete: if isDocOwner();\n    }\n    \n    match /notifications/{docId} {\n      allow read: if isAuthenticated();\n      allow create: if isCreatingOwn();\n      allow update, delete: if isDocOwner();\n    }\n    \n    // Security collections\n    match /loginHistory/{docId} {\n      allow read: if isAuthenticated();\n      allow create: if isCreatingOwn();\n      allow update, delete: if isDocOwner();\n    }\n    \n    match /sessions/{docId} {\n      allow read: if isAuthenticated();\n      allow create: if isCreatingOwn();\n      allow update, delete: if isDocOwner();\n    }\n    \n    match /securitySettings/{userId} {\n      allow read, write: if isOwner(userId);\n    }\n    \n    match /securityAlerts/{docId} {\n      allow read: if isAuthenticated();\n      allow create: if isCreatingOwn();\n      allow update, delete: if isDocOwner();\n    }\n    \n    match /emergencyAlerts/{docId} {\n      allow read: if isAuthenticated();\n      allow create: if isCreatingOwn();\n      allow update, delete: if isDocOwner();\n    }\n    \n    // Enhanced messaging collections\n    match /groupChats/{docId} {\n      allow read: if isAuthenticated();\n      allow create: if isAuthenticated();\n      allow update: if isAuthenticated();\n      allow delete: if isAuthenticated();\n    }\n    \n    match /groupMessages/{docId} {\n      allow read: if isAuthenticated();\n      allow create: if isAuthenticated();\n      allow update: if isAuthenticated();\n      allow delete: if isAuthenticated();\n    }\n    \n    match /broadcastChannels/{docId} {\n      allow read: if isAuthenticated();\n      allow create: if isAuthenticated();\n      allow update: if isAuthenticated();\n      allow delete: if isAuthenticated();\n    }\n    \n    match /broadcastMessages/{docId} {\n      allow read: if isAuthenticated();\n      allow create: if isAuthenticated();\n      allow delete: if isAuthenticated();\n    }\n    \n    match /scheduledMessages/{docId} {\n      allow read: if isAuthenticated();\n      allow create: if isCreatingOwn();\n      allow update, delete: if isDocOwner();\n    }\n    \n    match /messageTemplates/{docId} {\n      allow read: if isAuthenticated();\n      allow create: if isCreatingOwn();\n      allow update, delete: if isDocOwner();\n    }\n    \n    // Family invitations\n    match /familyInvitations/{docId} {\n      allow read: if isAuthenticated();\n      allow create: if isAuthenticated();\n      allow update: if isAuthenticated();\n      allow delete: if isAuthenticated();\n    }\n    \n    // Helper function to check if user is parent of child\n    function isParentOfChild(childId) {\n      return isAuthenticated() && \n        exists(/databases/$(database)/documents/users/$(childId)) &&\n        get(/databases/$(database)/documents/users/$(childId)).data.parentId == request.auth.uid;\n    }\n    \n    function isChildOrParent(childId, parentId) {\n      return isAuthenticated() && \n        (request.auth.uid == childId || request.auth.uid == parentId);\n    }\n    \n    // Child Tasks\n    match /childTasks/{taskId} {\n      allow read: if isAuthenticated() && \n        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);\n      allow create: if isAuthenticated() && request.resource.data.parentId == request.auth.uid;\n      allow update: if isAuthenticated() && \n        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);\n      allow delete: if isAuthenticated() && resource.data.parentId == request.auth.uid;\n    }\n    \n    // Child Homework\n    match /childHomework/{homeworkId} {\n      allow read: if isAuthenticated() && \n        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);\n      allow create: if isAuthenticated() && request.resource.data.parentId == request.auth.uid;\n      allow update: if isAuthenticated() && \n        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);\n      allow delete: if isAuthenticated() && resource.data.parentId == request.auth.uid;\n    }\n    \n    // Child Chores\n    match /childChores/{choreId} {\n      allow read: if isAuthenticated() && \n        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);\n      allow create: if isAuthenticated() && request.resource.data.parentId == request.auth.uid;\n      allow update: if isAuthenticated() && \n        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);\n      allow delete: if isAuthenticated() && resource.data.parentId == request.auth.uid;\n    }\n    \n    // Child Wallets\n    match /childWallets/{childId} {\n      allow read: if isAuthenticated() && \n        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);\n      allow write: if isAuthenticated() && \n        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);\n    }\n    \n    // Child Wallet Transactions\n    match /childWalletTransactions/{transactionId} {\n      allow read: if isAuthenticated() && \n        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);\n      allow create: if isAuthenticated();\n    }\n    \n    // Child Money Requests\n    match /childMoneyRequests/{requestId} {\n      allow read: if isAuthenticated() && \n        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);\n      allow create: if isAuthenticated() && request.resource.data.childId == request.auth.uid;\n      allow update: if isAuthenticated() && resource.data.parentId == request.auth.uid;\n    }\n    \n    // Child Behavior\n    match /childBehavior/{behaviorId} {\n      allow read: if isAuthenticated() && \n        (resource.data.childId == request.auth.uid || resource.data.addedBy == request.auth.uid);\n      allow create: if isAuthenticated();\n      allow update, delete: if isAuthenticated() && resource.data.addedBy == request.auth.uid;\n    }\n    \n    // Child Rewards\n    match /childRewards/{rewardId} {\n      allow read: if isAuthenticated() && \n        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);\n      allow create: if isAuthenticated() && request.resource.data.parentId == request.auth.uid;\n      allow update: if isAuthenticated() && \n        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);\n      allow delete: if isAuthenticated() && resource.data.parentId == request.auth.uid;\n    }\n    \n    // Child Screen Time\n    match /childScreenTime/{childId} {\n      allow read: if isAuthenticated() && \n        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);\n      allow write: if isAuthenticated() && resource.data.parentId == request.auth.uid;\n    }\n    \n    // Child SOS Alerts\n    match /childSOSAlerts/{alertId} {\n      allow read: if isAuthenticated() && \n        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);\n      allow create: if isAuthenticated() && request.resource.data.childId == request.auth.uid;\n      allow update: if isAuthenticated() && resource.data.parentId == request.auth.uid;\n    }\n    \n    // Child Location Shares\n    match /childLocationShares/{shareId} {\n      allow read: if isAuthenticated() && \n        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);\n      allow create: if isAuthenticated() && request.resource.data.childId == request.auth.uid;\n    }\n    \n    // Child Safe Locations\n    match /childSafeLocations/{locationId} {\n      allow read: if isAuthenticated() && \n        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);\n      allow create: if isAuthenticated() && request.resource.data.parentId == request.auth.uid;\n      allow update, delete: if isAuthenticated() && resource.data.parentId == request.auth.uid;\n    }\n    \n    // Child Games\n    match /childGames/{gameId} {\n      allow read: if isAuthenticated() && \n        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);\n      allow create: if isAuthenticated() && request.resource.data.parentId == request.auth.uid;\n      allow update, delete: if isAuthenticated() && resource.data.parentId == request.auth.uid;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2025-11-27T19:38:59.850015Z","metadata":{"services":["cloud.firestore"]}}
