[debug] [2025-11-27T02:32:35.073Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/family-housing-hub/rulesets {"name":"projects/family-housing-hub/rulesets/47c95988-48df-4140-98f9-5d6c794a4015","source":{"files":[{"content":"rules_version = '2';\nservice firebase.storage {\n  match /b/{bucket}/o {\n    \n    // Helper functions\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n    \n    function isOwner(userId) {\n      return request.auth.uid == userId;\n    }\n    \n    function isValidImage() {\n      return request.resource.contentType.matches('image/.*') &&\n             request.resource.size < 5 * 1024 * 1024;\n    }\n    \n    function isValidDocument() {\n      return (request.resource.contentType.matches('image/.*') ||\n              request.resource.contentType == 'application/pdf' ||\n              request.resource.contentType == 'application/msword' ||\n              request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document') &&\n             request.resource.size < 10 * 1024 * 1024;\n    }\n    \n    // Profile photos - 5MB limit\n    match /profile-photos/{userId}/{fileName} {\n      allow read: if isAuthenticated();\n      allow write: if isAuthenticated() && isOwner(userId) && isValidImage();\n      allow delete: if isAuthenticated() && isOwner(userId);\n    }\n    \n    // Maintenance images - 5MB limit\n    match /maintenance/{userId}/{requestId}/{fileName} {\n      allow read: if isAuthenticated();\n      allow write: if isAuthenticated() && isOwner(userId) && isValidImage();\n      allow delete: if isAuthenticated() && isOwner(userId);\n    }\n    \n    // Documents - 10MB limit\n    match /documents/{userId}/{fileName} {\n      allow read: if isAuthenticated();\n      allow write: if isAuthenticated() && isOwner(userId) && isValidDocument();\n      allow delete: if isAuthenticated() && isOwner(userId);\n    }\n    \n    // Receipts - 10MB limit\n    match /receipts/{userId}/{paymentId}/{fileName} {\n      allow read: if isAuthenticated() && isOwner(userId);\n      allow write: if isAuthenticated() && isOwner(userId) && isValidDocument();\n      allow delete: if isAuthenticated() && isOwner(userId);\n    }\n  }\n}\n","name":"storage.rules"}]},"createTime":"2025-11-27T02:32:35.043183Z","metadata":{"services":["firebase.storage"]}}
