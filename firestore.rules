rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    function isFamilyMember(familyId) {
      return request.auth != null && 
             get(/databases/$(database)/documents/families/$(familyId)).data.members.hasAny([request.auth.uid]);
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }
    
    // Families collection
    match /families/{familyId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Transactions collection
    match /transactions/{transactionId} {
      allow read, write: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // Budgets collection
    match /budgets/{budgetId} {
      allow read, write: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // Maintenance requests
    match /maintenanceRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // Rent payments
    match /rentPayments/{paymentId} {
      allow read, write: if isAuthenticated();
    }
    
    // Documents
    match /documents/{documentId} {
      allow read, write: if isAuthenticated();
    }
    
    // Messages
    match /messages/{messageId} {
      allow read, write: if isAuthenticated();
    }
    
    // Financial goals
    match /financialGoals/{goalId} {
      allow read, write: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // Bills
    match /bills/{billId} {
      allow read, write: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // Accounts
    match /accounts/{accountId} {
      allow read, write: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // Recurring transactions
    match /recurringTransactions/{transactionId} {
      allow read, write: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // Receipts collection
    match /receipts/{receiptId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // Shopping items collection
    match /shoppingItems/{itemId} {
      allow read: if isAuthenticated() && isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && isOwner(resource.data.userId);
    }
    
    // Family invite codes collection
    match /familyInviteCodes/{codeId} {
      // Allow authenticated users to read any active invite code
      allow read: if isAuthenticated();
      // Allow users to create invite codes for their own family
      allow create: if isAuthenticated() && 
                      request.resource.data.createdBy == request.auth.uid &&
                      (request.resource.data.familyId == request.auth.uid || 
                       request.resource.data.familyId != null);
      // Allow users to update invite codes they created or for their family
      allow update: if isAuthenticated() && 
                      (resource.data.createdBy == request.auth.uid ||
                       resource.data.familyId == request.auth.uid);
      // Allow users to delete invite codes they created
      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;
    }
    
    // Family invitations collection
    match /familyInvitations/{invitationId} {
      // Allow authenticated users to read invitations they sent or received
      allow read: if isAuthenticated() && 
                    (resource.data.inviterId == request.auth.uid ||
                     resource.data.inviteeEmail == request.auth.token.email);
      // Allow users to create invitations
      allow create: if isAuthenticated() && 
                      request.resource.data.inviterId == request.auth.uid;
      // Allow users to update invitations they sent
      allow update: if isAuthenticated() && 
                      resource.data.inviterId == request.auth.uid;
      // Allow users to delete invitations they sent
      allow delete: if isAuthenticated() && resource.data.inviterId == request.auth.uid;
    }
    
    // Email verifications collection
    // Allow unauthenticated users for signup flow, but strictly validate shape/fields.
    match /emailVerifications/{verificationId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'email', 'code', 'expiresAt', 'attempts', 'verified', 'createdAt'
        ]) &&
        request.resource.data.email is string &&
        request.resource.data.code is string &&
        request.resource.data.code.size() == 6 &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.attempts == 0 &&
        request.resource.data.verified == false;

      // Kept for current client-side verification flow.
      allow read: if resource.data.email is string;

      allow update: if
        resource.data.email is string &&
        resource.data.code is string &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.code == resource.data.code &&
        (
          // increment attempt by exactly 1
          request.resource.data.attempts == resource.data.attempts + 1 ||
          // mark verified
          (request.resource.data.verified == true && request.resource.data.attempts == resource.data.attempts)
        );

      // Cleanup job / client cleanup.
      allow delete: if true;
    }
    
    // Phone verifications collection
    // Allow unauthenticated users for signup flow, but strictly validate shape/fields.
    match /phoneVerifications/{verificationId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'phone', 'code', 'expiresAt', 'attempts', 'verified', 'createdAt'
        ]) &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() == 10 &&
        request.resource.data.code is string &&
        request.resource.data.code.size() == 6 &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.attempts == 0 &&
        request.resource.data.verified == false;

      // Kept for current client-side verification flow.
      allow read: if resource.data.phone is string;

      allow update: if
        resource.data.phone is string &&
        resource.data.code is string &&
        request.resource.data.phone == resource.data.phone &&
        request.resource.data.code == resource.data.code &&
        (
          // increment attempt by exactly 1
          request.resource.data.attempts == resource.data.attempts + 1 ||
          // mark verified
          (request.resource.data.verified == true && request.resource.data.attempts == resource.data.attempts)
        );

      // Cleanup job / client cleanup.
      allow delete: if true;
    }
  }
}
