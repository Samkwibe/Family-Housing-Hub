rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Check if user owns the document (for existing documents)
    function isDocOwner() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // Check if user is creating their own document
    function isCreatingOwn() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    
    // Users collection - users can read other users' profiles (for messaging/search), but only edit their own
    match /users/{userId} {
      allow read: if isAuthenticated(); // Allow reading any user profile for search/messaging
      allow write: if isOwner(userId); // Only edit own profile
      // Parents can read their children's profiles
      allow read: if isAuthenticated() && 
        resource.data.parentId == request.auth.uid;
    }
    
    // Generic rule for user-owned collections
    // This pattern allows queries filtered by userId
    match /maintenanceRequests/{docId} {
      allow read: if isAuthenticated();
      allow create: if isCreatingOwn();
      allow update, delete: if isDocOwner();
    }
    
    match /rentPayments/{docId} {
      allow read: if isAuthenticated();
      allow create: if isCreatingOwn();
      allow update, delete: if isDocOwner();
    }
    
    match /documents/{docId} {
      allow read: if isAuthenticated();
      allow create: if isCreatingOwn();
      allow update, delete: if isDocOwner();
    }
    
    // Messages - users can read messages where they are sender OR receiver
    match /messages/{docId} {
      // Allow read if user is sender or receiver (works for both get and list queries)
      // For queries, Firestore will filter results based on this rule
      allow read: if isAuthenticated() && 
        (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      // Allow create if user is the sender
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      // Allow update if user is sender or receiver (for read receipts)
      allow update: if isAuthenticated() && 
        (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      // Allow delete only if user is sender
      allow delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
    }
    
    match /activities/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }
    
    match /children/{docId} {
      allow read: if isAuthenticated();
      allow create: if isCreatingOwn();
      allow update, delete: if isDocOwner();
    }
    
    match /savingsGoals/{docId} {
      allow read: if isAuthenticated();
      allow create: if isCreatingOwn();
      allow update, delete: if isDocOwner();
    }
    
    match /healthRecords/{docId} {
      allow read: if isAuthenticated();
      allow create: if isCreatingOwn();
      allow update, delete: if isDocOwner();
    }
    
    match /appointments/{docId} {
      allow read: if isAuthenticated();
      allow create: if isCreatingOwn();
      allow update, delete: if isDocOwner();
    }
    
    match /transactions/{docId} {
      allow read: if isAuthenticated();
      allow create: if isCreatingOwn();
      allow update, delete: if isDocOwner();
    }
    
        match /budgets/{docId} {
          allow read: if isAuthenticated();
          allow create: if isCreatingOwn();
          allow update, delete: if isDocOwner();
        }
        
        match /financialGoals/{docId} {
          allow read: if isAuthenticated();
          allow create: if isCreatingOwn();
          allow update, delete: if isDocOwner();
        }
        
        match /bills/{docId} {
          allow read: if isAuthenticated();
          allow create: if isCreatingOwn();
          allow update, delete: if isDocOwner();
        }
        
        match /accounts/{docId} {
          allow read: if isAuthenticated();
          allow create: if isCreatingOwn();
          allow update, delete: if isDocOwner();
        }
        
        match /recurringTransactions/{docId} {
          allow read: if isAuthenticated();
          allow create: if isCreatingOwn();
          allow update, delete: if isDocOwner();
        }
    
    match /events/{docId} {
      allow read: if isAuthenticated();
      allow create: if isCreatingOwn();
      allow update, delete: if isDocOwner();
    }
    
    match /tasks/{docId} {
      allow read: if isAuthenticated();
      allow create: if isCreatingOwn();
      allow update, delete: if isDocOwner();
    }
    
    match /shoppingItems/{docId} {
      allow read: if isAuthenticated();
      allow create: if isCreatingOwn();
      allow update, delete: if isDocOwner();
    }
    
    match /meals/{docId} {
      allow read: if isAuthenticated();
      allow create: if isCreatingOwn();
      allow update, delete: if isDocOwner();
    }
    
    match /emergencyContacts/{docId} {
      allow read: if isAuthenticated();
      allow create: if isCreatingOwn();
      allow update, delete: if isDocOwner();
    }
    
    match /safeLocations/{docId} {
      allow read: if isAuthenticated();
      allow create: if isCreatingOwn();
      allow update, delete: if isDocOwner();
    }
    
    match /notifications/{docId} {
      allow read: if isAuthenticated();
      allow create: if isCreatingOwn();
      allow update, delete: if isDocOwner();
    }
    
    // Security collections
    match /loginHistory/{docId} {
      allow read: if isAuthenticated();
      allow create: if isCreatingOwn();
      allow update, delete: if isDocOwner();
    }
    
    match /sessions/{docId} {
      allow read: if isAuthenticated();
      allow create: if isCreatingOwn();
      allow update, delete: if isDocOwner();
    }
    
    match /securitySettings/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    match /securityAlerts/{docId} {
      allow read: if isAuthenticated();
      allow create: if isCreatingOwn();
      allow update, delete: if isDocOwner();
    }
    
    match /emergencyAlerts/{docId} {
      allow read: if isAuthenticated();
      allow create: if isCreatingOwn();
      allow update, delete: if isDocOwner();
    }
    
    // Enhanced messaging collections
    match /groupChats/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    match /groupMessages/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    match /broadcastChannels/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    match /broadcastMessages/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    match /scheduledMessages/{docId} {
      allow read: if isAuthenticated();
      allow create: if isCreatingOwn();
      allow update, delete: if isDocOwner();
    }
    
    match /messageTemplates/{docId} {
      allow read: if isAuthenticated();
      allow create: if isCreatingOwn();
      allow update, delete: if isDocOwner();
    }
    
    // Family invitations
    match /familyInvitations/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    // Helper function to check if user is parent of child
    function isParentOfChild(childId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(childId)) &&
        get(/databases/$(database)/documents/users/$(childId)).data.parentId == request.auth.uid;
    }
    
    function isChildOrParent(childId, parentId) {
      return isAuthenticated() && 
        (request.auth.uid == childId || request.auth.uid == parentId);
    }
    
    // Child Tasks
    match /childTasks/{taskId} {
      allow read: if isAuthenticated() && 
        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.parentId == request.auth.uid;
      allow update: if isAuthenticated() && 
        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);
      allow delete: if isAuthenticated() && resource.data.parentId == request.auth.uid;
    }
    
    // Child Homework
    match /childHomework/{homeworkId} {
      allow read: if isAuthenticated() && 
        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.parentId == request.auth.uid;
      allow update: if isAuthenticated() && 
        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);
      allow delete: if isAuthenticated() && resource.data.parentId == request.auth.uid;
    }
    
    // Child Chores
    match /childChores/{choreId} {
      allow read: if isAuthenticated() && 
        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.parentId == request.auth.uid;
      allow update: if isAuthenticated() && 
        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);
      allow delete: if isAuthenticated() && resource.data.parentId == request.auth.uid;
    }
    
    // Child Wallets
    match /childWallets/{childId} {
      allow read: if isAuthenticated() && 
        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);
      allow write: if isAuthenticated() && 
        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);
    }
    
    // Child Wallet Transactions
    match /childWalletTransactions/{transactionId} {
      allow read: if isAuthenticated() && 
        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);
      allow create: if isAuthenticated();
    }
    
    // Child Money Requests
    match /childMoneyRequests/{requestId} {
      allow read: if isAuthenticated() && 
        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.childId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.parentId == request.auth.uid;
    }
    
    // Child Behavior
    match /childBehavior/{behaviorId} {
      allow read: if isAuthenticated() && 
        (resource.data.childId == request.auth.uid || resource.data.addedBy == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.addedBy == request.auth.uid;
    }
    
    // Child Rewards
    match /childRewards/{rewardId} {
      allow read: if isAuthenticated() && 
        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.parentId == request.auth.uid;
      allow update: if isAuthenticated() && 
        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);
      allow delete: if isAuthenticated() && resource.data.parentId == request.auth.uid;
    }
    
    // Child Screen Time
    match /childScreenTime/{childId} {
      allow read: if isAuthenticated() && 
        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);
      allow write: if isAuthenticated() && resource.data.parentId == request.auth.uid;
    }
    
    // Child SOS Alerts
    match /childSOSAlerts/{alertId} {
      allow read: if isAuthenticated() && 
        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.childId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.parentId == request.auth.uid;
    }
    
    // Child Location Shares
    match /childLocationShares/{shareId} {
      allow read: if isAuthenticated() && 
        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.childId == request.auth.uid;
    }
    
    // Child Safe Locations
    match /childSafeLocations/{locationId} {
      allow read: if isAuthenticated() && 
        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.parentId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.parentId == request.auth.uid;
    }
    
    // Child Games
    match /childGames/{gameId} {
      allow read: if isAuthenticated() && 
        (resource.data.childId == request.auth.uid || resource.data.parentId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.parentId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.parentId == request.auth.uid;
    }
  }
}
