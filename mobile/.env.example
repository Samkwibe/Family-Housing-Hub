# MOBILE APP ONLY — copy to mobile/.env (never commit mobile/.env; it is gitignored)
# See backend/.env (server) and .env.local (web)

EXPO_PUBLIC_API_URL=https://family-housing-hub-production.up.railway.app

# Google Maps API key (same value as backend GOOGLE_MAPS_API_KEY)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth Client IDs (NOT API keys)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-oauth-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-oauth-client-id.apps.googleusercontent.com

EXPO_PUBLIC_SHOW_VERIFICATION_CODES=false
